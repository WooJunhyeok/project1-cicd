groups:
  - name: disk_alerts
    rules:
      - alert: HighDiskUsage
        expr: (node_filesystem_size_bytes{fstype!~"tmpfs|overlay"} 
              - node_filesystem_free_bytes{fstype!~"tmpfs|overlay"})
              / node_filesystem_size_bytes{fstype!~"tmpfs|overlay"} * 100 > 90
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "High Disk Usage on {{ $labels.instance }}"
          description: "Disk usage has exceeded 90% for more than 5 minutes."

